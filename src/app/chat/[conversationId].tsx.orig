    fontWeight: '800',
  },
  contactNumber: {
    fontSize: 12,
    marginTop: 2,
  },
  messagesContent: {
    paddingBottom: 18,
    paddingTop: 16,
  },
  dayPill: {
    alignSelf: 'center',
